# Copy to .env (ignored by git) before `docker compose up`.
# Read only by docker-compose.yml (and docker-compose.prod.yml). Never commit
# the real .env.

# Required by the backend containers: HMAC-SHA256 key, at least 32 bytes.
# Generate a new one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_KEY=

# Optional locally. Development database password; the default matches
# backend/GameHub.Api/appsettings.Development.json. It only takes effect when
# the database volume is created for the first time.
# POSTGRES_PASSWORD=gamehub_dev_password

# Optional locally (defaults: gamehub-local, gamehub-local, localhost).
# JWT_ISSUER=
# JWT_AUDIENCE=
# ALLOWED_HOSTS=

# --- Production (docker-compose.prod.yml) ------------------------------------
# All of these are required there, with no defaults:
#   POSTGRES_PASSWORD        strong password, new for production
#   JWT_KEY                  new key, never the development one
#   JWT_ISSUER, JWT_AUDIENCE e.g. https://gamehub.example.com
#   ALLOWED_HOSTS            public host name(s), e.g. gamehub.example.com
#   FORWARDED_KNOWN_NETWORK  CIDR the reverse proxy connects from,
#                            e.g. 172.16.0.0/12 for a proxy on the Docker host
