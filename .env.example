# Copy to .env (ignored by git) before `docker compose up`.
# Read only by docker-compose.yml. Never commit the real .env.

# Required by the backend containers: HMAC-SHA256 key, at least 32 bytes.
# Generate a new one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_KEY=

# Optional. Development database password; the default matches
# backend/GameHub.Api/appsettings.Development.json. It only takes effect when
# the database volume is created for the first time.
# POSTGRES_PASSWORD=gamehub_dev_password
