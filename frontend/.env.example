# Copy to .env.production.local (ignored by git) or set in the build
# environment. Every VITE_* value is embedded in the public JavaScript bundle:
# NEVER put secrets here (JWT key, database password, private keys).

# Backend origin, only when the API is served from a different origin than the
# frontend (the backend must then list the frontend in Cors__AllowedOrigins__0).
# Leave unset to use relative URLs (/api, /hubs/chat): the Vite proxy in
# development, or a reverse proxy serving both on the same domain.
# VITE_API_URL=https://api.example.com
